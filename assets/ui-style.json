        "style": "solid"
      },
      "radius": 14,
      "padding": {
        "top": 13,
        "end": 19,
        "bottom": 13,
        "start": 19
      }
    },
    ".countdown": {
      "text": {
        "color": "$accent",
        "size": 144,
        "weight": "800",
        "shadow": {
          "y": 6,
          "blur": 32,
          "color": "#000000b3"
        }
      }
    },
    ".void-label": {
