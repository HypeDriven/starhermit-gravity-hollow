{
  "styles": {
    ".body": {
      "text": {
        "color": "$text",
        "size": 16
      }
    },
    ".dim": {
      "text": {
        "color": "$dim",
        "size": 16
      }
    },
    ".small": {
      "text": {
        "color": "$dim",
        "size": 13.6
      }
    },
    ".logo": {
      "text": {
        "color": "$accent",
        "size": 48,
        "weight": "700",
        "letterSpacing": 1
      }
    },
    ".logo-small": {
      "text": {
        "color": "$accent",
        "size": 32,
        "weight": "700",
        "letterSpacing": 1
      }
    },
    ".headline": {
      "text": {
        "color": "$text",
        "size": 20.8,
        "weight": "600"
      }
    },
    ".h2": {
      "text": {
        "color": "$text",
        "size": 24,
        "weight": "700"
      }
    },
    ".h3": {
      "text": {
        "color": "$text",
        "size": 18.7,
        "weight": "700"
      }
    },
    ".h4": {
      "text": {
        "color": "$text",
        "size": 16,
        "weight": "700"
      }
    },
    ".accent": {
      "text": {
        "color": "$accent",
        "size": 16
      }
    },
    ".danger-text": {
      "text": {
        "color": "$danger",
        "size": 16
      }
    },
    ".me": {
      "text": {
        "color": "$accent",
        "size": 16,
        "weight": "700"
      }
    },
    ".dt": {
      "text": {
        "color": "$dim",
        "size": 16
      }
    },
    ".dd": {
      "text": {
        "color": "$text",
        "size": 16,
        "numerals": "tabular"
      }
    },
    ".total": {
      "text": {
        "color": "$accent",
        "size": 16,
        "weight": "700",
        "numerals": "tabular"
      }
    },
    ".total-row": {
      "border": {
        "width": {
          "top": 1
        },
        "color": {
          "top": "$panel-border"
        },
        "style": "solid"
      },
      "padding": {
        "top": 4,
        "end": 0,
        "bottom": 0,
        "start": 0
      }
    },
    ".legend": {
      "text": {
        "color": "$accent",
        "size": 16
      }
    },
    ".screen": {
      "background": "#050806bd"
    },
    ".panel": {
      "background": "$panel",
      "border": {
        "width": 1,
        "color": "$panel-border",
        "style": "solid"
      },
      "radius": 14,
      "shadow": {
        "y": 18,
        "blur": 60,
        "color": "#00000080"
      },
      "padding": {
        "top": 22,
        "end": 26,
        "bottom": 22,
        "start": 26
      }
    },
    ".fieldset": {
      "border": {
        "width": 1,
        "color": "$panel-border",
        "style": "solid"
      },
      "radius": 10,
      "padding": 12
    },
    ".art": {
      "border": {
        "width": 1,
        "color": "$panel-border",
        "style": "solid"
      },
      "radius": 10
    },
    ".btn": {
      "background": "#1c2b23",
      "border": {
        "width": 1,
        "color": "$panel-border",
        "style": "solid"
      },
      "radius": 10,
      "padding": {
        "top": 10,
        "end": 18,
        "bottom": 10,
        "start": 18
      },
      "minWidth": 44,
      "minHeight": 44,
      "text": {
        "color": "$text",
        "size": 16,
        "align": "center"
      },
      "hovered": {
        "background": "#24382d"
      },
      "focusVisible": {
        "focusRing": {
          "width": 3,
          "color": "$focus",
          "offset": 2
        }
      },
      "pressed": {
        "scale": 0.97
      },
      "disabled": {
        "opacity": 0.45
      }
    },
    ".btn-primary": {
      "background": {
        "type": "linear",
        "angle": 140,
        "stops": ["#2c6b45", "#1f4d33"]
      },
      "border": {
        "color": "$accent"
      },
      "text": {
        "weight": "600"
      },
      "hovered": {
        "background": {
          "type": "linear",
          "angle": 140,
          "stops": ["#347d51", "#24583b"]
        }
      }
    },
    ".btn-big": {
      "padding": {
        "top": 14,
        "end": 38,
        "bottom": 14,
        "start": 38
      },
      "text": {
        "size": 20
      }
    },
    ".btn-secondary": {
      "background": "#16241d"
    },
    ".btn-ghost": {
      "background": "#00000000",
      "border": {
        "color": "#00000000"
      },
      "text": {
        "color": "$dim"
      },
      "hovered": {
        "background": "#00000000",
        "text": {
          "color": "$text"
        }
      }
    },
    ".btn-danger": {
      "background": "#3a1c16",
      "border": {
        "color": "$danger"
      },
      "hovered": {
        "background": "#4a241c"
      }
    },
    ".btn-small": {
      "padding": {
        "top": 6,
        "end": 12,
        "bottom": 6,
        "start": 12
      },
      "minHeight": 36,
      "text": {
        "size": 13.6
      }
    },
    ".mode-card": {
      "background": "$card",
      "border": {
        "width": 1,
        "color": "$panel-border",
        "style": "solid"
      },
      "radius": 14,
      "padding": 16,
      "minHeight": 44,
      "text": {
        "color": "$text",
        "align": "start"
      },
      "hovered": {
        "background": "#1a2b22"
      },
      "focusVisible": {
        "focusRing": {
          "width": 3,
          "color": "$focus",
          "offset": 2
        }
      }
    },
    ".card-title": {
      "text": {
        "color": "$text",
        "size": 16.8,
        "weight": "700"
      }
    },
    ".card-desc": {
      "text": {
        "color": "$dim",
        "size": 13.6
      }
    },
    ".badge": {
      "background": "#2c5240",
      "radius": 6,
      "padding": {
        "top": 1,
        "end": 7,
        "bottom": 1,
        "start": 7
      },
      "text": {
        "color": "$text",
        "size": 11.2
      }
    },
    ".info-card": {
      "background": "$card",
      "border": {
        "width": 1,
        "color": "$panel-border",
        "style": "solid"
      },
      "radius": 14,
      "padding": 16
    },
    ".journey-cell": {
      "background": "#1c2b23",
      "border": {
        "width": 1,
        "color": "$panel-border",
        "style": "solid"
      },
      "radius": 10,
      "padding": 4,
      "text": {
        "color": "$text",
        "size": 14.4,
        "align": "center"
      },
      "hovered": {
        "background": "#24382d"
      },
      "focusVisible": {
        "focusRing": {
          "width": 3,
          "color": "$focus",
          "offset": 2
        }
      },
      "disabled": {
        "opacity": 0.35
      }
    },
    ".journey-mastery": {
      "background": "#1c2b23",
      "border": {
        "width": 1,
        "color": "$accent-2",
        "style": "solid"
      },
      "radius": 10,
      "padding": 4,
      "text": {
        "color": "$text",
        "size": 14.4,
        "align": "center"
      },
      "hovered": {
        "background": "#24382d"
      },
      "focusVisible": {
        "focusRing": {
          "width": 3,
          "color": "$focus",
          "offset": 2
        }
      },
      "disabled": {
        "opacity": 0.35
      }
    },
    ".stars": {
      "text": {
        "color": "$focus",
        "size": 10.4
      }
    },
    ".ach-row": {
      "background": "$card",
      "border": {
        "width": 1,
        "color": "$panel-border",
        "style": "solid"
      },
      "radius": 8,
      "padding": {
        "top": 8,
        "end": 13,
        "bottom": 8,
        "start": 13
      }
    },
    ".ach-unlocked": {
      "background": "$card",
      "border": {
        "width": 1,
        "color": "$accent",
        "style": "solid"
      },
      "radius": 8,
      "padding": {
        "top": 8,
        "end": 13,
        "bottom": 8,
        "start": 13
      }
    },
    ".ach-locked": {
      "background": "$card",
      "border": {
        "width": 1,
        "color": "$panel-border",
        "style": "solid"
      },
      "radius": 8,
      "padding": {
        "top": 8,
        "end": 13,
        "bottom": 8,
        "start": 13
      },
      "opacity": 0.45
    },
    ".hud-card": {
      "background": "$panel",
      "border": {
        "width": 1,
        "color": "$panel-border",
        "style": "solid"
      },
      "radius": 10,
      "padding": {
        "top": 6,
        "end": 13,
        "bottom": 6,
        "start": 13
      }
    },
