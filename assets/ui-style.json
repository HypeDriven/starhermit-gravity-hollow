  "animations": {},
  "tokens": {
    "accent": "#9fe6a0",
    "accent-2": "#64f2c0",
    "bg": "#0b100d",
    "card": "#14211a",
    "danger": "#ff7a5c",
    "dim": "#9db3a6",
    "focus": "#ffe066",
    "panel": "#101814eb",
    "panel-border": "#2c5240",
    "panel-solid": "#101814",
    "text": "#e8f0ea"
  },
  "layouts": {},
  "dropped": []
}
