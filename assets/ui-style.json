        "size": 14.4
      }
    },
    ".hud-timer": {
      "text": {
        "color": "$text",
        "size": 24,
        "weight": "700",
        "numerals": "tabular"
      }
    },
    ".hud-timer-late": {
      "text": {
        "color": "$danger",
        "size": 24,
        "weight": "700",
        "numerals": "tabular"
      }
    },
    ".hud-ranks": {
