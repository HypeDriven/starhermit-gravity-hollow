        "focusRing": {
          "width": 3,
          "color": "$focus",
          "offset": 2
        }
      }
    },
    ".hud-btn": {
      "background": "#1c2b23",
      "border": {
        "width": 1,
        "color": "$panel-border",
        "style": "solid"
      },
      "radius": 10,
      "padding": {
        "top": 6,
        "end": 14,
        "bottom": 6,
        "start": 14
      },
      "minWidth": 44,
      "minHeight": 44,
      "text": {
        "color": "$text",
        "size": 17.6
      },
      "hovered": {
        "background": "#24382d"
      },
      "focusVisible": {
        "focusRing": {
          "width": 3,
          "color": "$focus",
          "offset": 2
        }
      }
    },
    ".banner": {
      "background": "$panel",
      "border": {
        "width": 1,
