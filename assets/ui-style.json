    ".tray-btn": {
      "background": "$panel",
      "border": {
        "width": 1,
        "color": "$panel-border",
        "style": "solid"
      },
      "radius": 32,
      "hovered": {
        "background": "#1a2b22"
      },
      "focusVisible": {
        "focusRing": {
          "width": 3,
          "color": "$focus",
          "offset": 2
        }
      }
    },
    ".tray-boost": {
